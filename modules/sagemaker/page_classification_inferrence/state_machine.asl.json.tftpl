{
  "Comment": "Page classification processing pipeline",
  "StartAt": "FetchDbCredentials",
  "States": {
    "FetchDbCredentials": {
      "Type": "Task",
      "Resource": "arn:${partition}:states:::aws-sdk:secretsmanager:getSecretValue",
      "Parameters": {
        "SecretId": "${database_credentials_secret_arn}"
      },
      "ResultSelector": {
        "db.$": "States.StringToJson($.SecretString)"
      },
      "ResultPath": "$.secrets",
      "Next": "ExtractDateAndTime"
    },
    "ExtractDateAndTime": {
      "Type": "Pass",
      "Parameters": {
        "date.$": "States.ArrayGetItem(States.StringSplit($$.State.EnteredTime, 'T'), 0)",
        "time.$": "States.ArrayGetItem(States.StringSplit($$.State.EnteredTime, 'T'), 1)"
      },
      "ResultPath": "$.meta",
      "Next": "ExtractTimeParts"
    },
    "ExtractTimeParts": {
      "Type": "Pass",
      "Parameters": {
        "date.$": "$.meta.date",
        "hh.$": "States.ArrayGetItem(States.StringSplit($.meta.time, ':'), 0)",
        "mm.$": "States.ArrayGetItem(States.StringSplit($.meta.time, ':'), 1)",
        "ss_frac.$": "States.ArrayGetItem(States.StringSplit($.meta.time, ':'), 2)"
      },
      "ResultPath": "$.meta",
      "Next": "ExtractSeconds"
    },
    "ExtractSeconds": {
      "Type": "Pass",
      "Parameters": {
        "date.$": "$.meta.date",
        "hh.$": "$.meta.hh",
        "mm.$": "$.meta.mm",
        "ss.$": "States.ArrayGetItem(States.StringSplit($.meta.ss_frac, '.'), 0)"
      },
      "ResultPath": "$.meta",
      "Next": "BuildJobTimestamp"
    },
    "BuildJobTimestamp": {
      "Type": "Pass",
      "Parameters": {
        "job_ts.$": "States.Format('{}-{}{}{}', $.meta.date, $.meta.hh, $.meta.mm, $.meta.ss)"
      },
      "ResultPath": "$.meta",
      "Next": "GenerateDataset"
    },
    "GenerateDataset": {
      "Type": "Task",
      "Resource": "arn:${partition}:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('generate-classify-infer-dataset-{}', $.meta.job_ts)",
        "RoleArn": "${sagemaker_role_arn}",
        "Tags": [
          {"Key": "Project", "Value": "furniture"},
          {"Key": "Name", "Value": "furniture-sagemaker-generate-classification-inference-dataset"}
        ],
        "AppSpecification": {
          "ImageUri": "${dataset_image_uri}",
          "ContainerEntrypoint": ["python3"],
          "ContainerArguments": ["/opt/ml/processing/input/code/generate_classification_inference_dataset.py"]
        },
        "Environment": {
          "PG_HOST": "${pg_host}",
          "PG_USER.$": "$.secrets.db.username",
          "PG_PASSWORD.$": "$.secrets.db.password",
          "PG_DATABASE.$": "$.secrets.db.database_name",
          "PG_PORT": "${pg_port}",
          "INFERENCE_QUERY_LIMIT": "${inference_query_limit}",
          "MARKUPLM_MODEL_ID": "${markuplm_model_id}",
          "S3_FETCH_NUM_PROC": "${s3_fetch_num_proc}",
          "TOKENIZE_NUM_PROC": "${tokenize_num_proc}",
          "S3_FETCH_THREADS": "${s3_fetch_threads}"
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "${dataset_instance_type}",
            "VolumeSizeInGB": ${volume_size_gb}
          }
        },
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "S3Uri": "${dataset_script_s3_uri}",
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "dataset",
              "S3Output": {
                "S3Uri": "${dataset_output_s3_uri}",
                "LocalPath": "/opt/ml/processing/output/",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleGenerateDatasetFailure"
        }
      ],
      "Next": "ClassificationInference"
    },
    "ClassificationInference": {
      "Type": "Task",
      "Resource": "arn:${partition}:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('classify-infer-{}', $.meta.job_ts)",
        "RoleArn": "${sagemaker_role_arn}",
        "Tags": [
          {"Key": "Project", "Value": "furniture"},
          {"Key": "Name", "Value": "furniture-sagemaker-classification-inference"}
        ],
        "AppSpecification": {
          "ImageUri": "${inference_image_uri}",
          "ContainerEntrypoint": ["python3"],
          "ContainerArguments": ["/opt/ml/processing/input/code/classification_inference.py"]
        },
        "Environment": {
          "INFERENCE_BATCH_SIZE": "${inference_batch_size}",
          "CPU_DYNAMIC_QUANTIZATION": "${cpu_dynamic_quantization}",
          "SKIP_RUNTIME_PIP": "${skip_runtime_pip}"
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "${inference_instance_type}",
            "VolumeSizeInGB": ${volume_size_gb}
          }
        },
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "S3Uri": "${inference_script_s3_uri}",
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          },
          {
            "InputName": "dataset",
            "S3Input": {
              "S3Uri": "${dataset_output_s3_uri}",
              "LocalPath": "/opt/ml/processing/input/dataset",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          },
          {
            "InputName": "model",
            "S3Input": {
              "S3Uri": "${model_s3_uri}",
              "LocalPath": "/opt/ml/processing/input/model",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "predictions",
              "S3Output": {
                "S3Uri": "${predictions_output_s3_uri}",
                "LocalPath": "/opt/ml/processing/output",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleClassificationInferenceFailure"
        }
      ],
      "Next": "UpdateClassificationTable"
    },
    "UpdateClassificationTable": {
      "Type": "Task",
      "Resource": "arn:${partition}:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('update-classify-table-{}', $.meta.job_ts)",
        "RoleArn": "${sagemaker_role_arn}",
        "Tags": [
          {"Key": "Project", "Value": "furniture"},
          {"Key": "Name", "Value": "furniture-sagemaker-update-classification-table"}
        ],
        "AppSpecification": {
          "ImageUri": "${update_image_uri}",
          "ContainerEntrypoint": ["python3"],
          "ContainerArguments": ["/opt/ml/processing/input/code/update_classification_table.py"]
        },
        "Environment": {
          "PG_HOST": "${pg_host}",
          "PG_USER.$": "$.secrets.db.username",
          "PG_PASSWORD.$": "$.secrets.db.password",
          "PG_DATABASE.$": "$.secrets.db.database_name",
          "PG_PORT": "${pg_port}",
          "PREDICTIONS_PATH": "/opt/ml/processing/input/predictions.jsonl"
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "${update_instance_type}",
            "VolumeSizeInGB": ${volume_size_gb}
          }
        },
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "S3Uri": "${update_script_s3_uri}",
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          },
          {
            "InputName": "predictions",
            "S3Input": {
              "S3Uri": "${predictions_input_s3_uri}",
              "LocalPath": "/opt/ml/processing/input/",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ]
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleUpdateClassificationTableFailure"
        }
      ],
      "End": true
    },
    "HandleGenerateDatasetFailure": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.error.Cause",
              "StringMatches": "*CapacityError*"
            },
            {
              "Or": [
                {
                  "Variable": "$.retry.generate_dataset_count",
                  "IsPresent": false
                },
                {
                  "Variable": "$.retry.generate_dataset_count",
                  "NumericEquals": 0
                }
              ]
            }
          ],
          "Next": "WaitBeforeRetryGenerateDataset"
        },
        {
          "And": [
            {
              "Variable": "$.error.Cause",
              "StringMatches": "*CapacityError*"
            },
            {
              "Variable": "$.retry.generate_dataset_count",
              "NumericEquals": 1
            }
          ],
          "Next": "WaitBeforeSecondRetryGenerateDataset"
        }
      ],
      "Default": "PipelineFailed"
    },
    "WaitBeforeRetryGenerateDataset": {
      "Type": "Wait",
      "Seconds": 3600,
      "Next": "MarkGenerateDatasetRetried"
    },
    "MarkGenerateDatasetRetried": {
      "Type": "Pass",
      "Result": 1,
      "ResultPath": "$.retry.generate_dataset_count",
      "Next": "GenerateDataset"
    },
    "WaitBeforeSecondRetryGenerateDataset": {
      "Type": "Wait",
      "Seconds": 3600,
      "Next": "MarkGenerateDatasetSecondRetried"
    },
    "MarkGenerateDatasetSecondRetried": {
      "Type": "Pass",
      "Result": 2,
      "ResultPath": "$.retry.generate_dataset_count",
      "Next": "GenerateDataset"
    },
    "HandleClassificationInferenceFailure": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.error.Cause",
              "StringMatches": "*CapacityError*"
            },
            {
              "Or": [
                {
                  "Variable": "$.retry.classification_inference_count",
                  "IsPresent": false
                },
                {
                  "Variable": "$.retry.classification_inference_count",
                  "NumericEquals": 0
                }
              ]
            }
          ],
          "Next": "WaitBeforeRetryClassificationInference"
        },
        {
          "And": [
            {
              "Variable": "$.error.Cause",
              "StringMatches": "*CapacityError*"
            },
            {
              "Variable": "$.retry.classification_inference_count",
              "NumericEquals": 1
            }
          ],
          "Next": "WaitBeforeSecondRetryClassificationInference"
        }
      ],
      "Default": "PipelineFailed"
    },
    "WaitBeforeRetryClassificationInference": {
      "Type": "Wait",
      "Seconds": 3600,
      "Next": "MarkClassificationInferenceRetried"
    },
    "MarkClassificationInferenceRetried": {
      "Type": "Pass",
      "Result": 1,
      "ResultPath": "$.retry.classification_inference_count",
      "Next": "ClassificationInference"
    },
    "WaitBeforeSecondRetryClassificationInference": {
      "Type": "Wait",
      "Seconds": 3600,
      "Next": "MarkClassificationInferenceSecondRetried"
    },
    "MarkClassificationInferenceSecondRetried": {
      "Type": "Pass",
      "Result": 2,
      "ResultPath": "$.retry.classification_inference_count",
      "Next": "ClassificationInference"
    },
    "HandleUpdateClassificationTableFailure": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.error.Cause",
              "StringMatches": "*CapacityError*"
            },
            {
              "Or": [
                {
                  "Variable": "$.retry.update_classification_table_count",
                  "IsPresent": false
                },
                {
                  "Variable": "$.retry.update_classification_table_count",
                  "NumericEquals": 0
                }
              ]
            }
          ],
          "Next": "WaitBeforeRetryUpdateClassificationTable"
        },
        {
          "And": [
            {
              "Variable": "$.error.Cause",
              "StringMatches": "*CapacityError*"
            },
            {
              "Variable": "$.retry.update_classification_table_count",
              "NumericEquals": 1
            }
          ],
          "Next": "WaitBeforeSecondRetryUpdateClassificationTable"
        }
      ],
      "Default": "PipelineFailed"
    },
    "WaitBeforeRetryUpdateClassificationTable": {
      "Type": "Wait",
      "Seconds": 3600,
      "Next": "MarkUpdateClassificationTableRetried"
    },
    "MarkUpdateClassificationTableRetried": {
      "Type": "Pass",
      "Result": 1,
      "ResultPath": "$.retry.update_classification_table_count",
      "Next": "UpdateClassificationTable"
    },
    "WaitBeforeSecondRetryUpdateClassificationTable": {
      "Type": "Wait",
      "Seconds": 3600,
      "Next": "MarkUpdateClassificationTableSecondRetried"
    },
    "MarkUpdateClassificationTableSecondRetried": {
      "Type": "Pass",
      "Result": 2,
      "ResultPath": "$.retry.update_classification_table_count",
      "Next": "UpdateClassificationTable"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineExecutionFailed",
      "Cause": "A SageMaker processing stage failed. Inspect execution history for details."
    }
  }
}

